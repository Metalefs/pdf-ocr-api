<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pdf_ocr</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core & Swagger -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="PDFium.LinuxV2" Version="1.1.4" />
    <PackageReference Include="PDFium.x64" Version="4648.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
	<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    
    <!-- AUTENTICAÇÃO JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    
    <!-- STRIPE PAGAMENTOS -->
    <PackageReference Include="Stripe.net" Version="50.1.0" />

	<!-- SUPABASE (Database Persistence) -->
	<PackageReference Include="postgrest-csharp" Version="3.5.1" />
	<PackageReference Include="supabase-csharp" Version="0.16.2" />
    
    <!-- iText 7 (PDF manipulation) -->
    <PackageReference Include="itext7" Version="9.5.0" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.5.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    
    <!-- PDFium (PDF rendering) -->
	  <PackageReference Include="PDFiumSharp" Version="1.0.0" />

	  <PackageReference Include="PDFiumSharpV2" Version="1.1.4" />
    
    <!-- System.Drawing para conversão de imagens -->
	  <PackageReference Include="System.Drawing.Common" Version="10.0.1" />

	  <!-- Tesseract OCR -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Drawing" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="C:\Users\jack-\.nuget\packages\pdfiumsharp\1.0.0\build\netstandard1.4\pdfium_x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="C:\Users\jack-\.nuget\packages\pdfiumsharp\1.0.0\build\netstandard1.4\pdfium_x86.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>