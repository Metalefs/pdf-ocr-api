# Copy to .env and fill values
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANT: do not commit your real .env

# Redis password for the redis container (required by docker-compose.prod.yml)
REDIS_PASSWORD=change-me-to-a-long-random-secret

# Optional: if you prefer cloud-style REDIS_URL (supported by Program.cs)
# REDIS_URL=redis://:password@hostname:6379
