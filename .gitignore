# ============================================
# .gitignore
# ============================================
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/
.vscode/

# Test files
*.coverage
*.coveragexml

# NuGet
*.nupkg
**/packages/*

# Docker
.dockerignore

# Rider
.idea/

# Temp files
*.tmp
*.log
ocr_temp_*/
ocr_jobs/

# OS files
.DS_Store
Thumbs.db
